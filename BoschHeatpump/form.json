{
    "elements": [
        {
            "type": "ExpansionPanel",
            "caption": "MQTT Verbindung",
            "expanded": true,
            "items": [
                {
                    "name": "TopicPrefix",
                    "type": "ValidationTextBox",
                    "caption": "Topic-Praefix (Standard: ems-esp)"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Geraete-Konfiguration",
            "expanded": true,
            "items": [
                {
                    "name": "EnableBoiler",
                    "type": "CheckBox",
                    "caption": "Kessel und Waermepumpe aktivieren"
                },
                {
                    "name": "EnableThermostat",
                    "type": "CheckBox",
                    "caption": "Thermostat aktivieren"
                },
                {
                    "name": "EnableEnergy",
                    "type": "CheckBox",
                    "caption": "Energiedaten und COP aktivieren"
                },
                {
                    "name": "UpdateInterval",
                    "type": "NumberSpinner",
                    "caption": "Polling-Intervall in Sekunden",
                    "minimum": 0,
                    "maximum": 3600,
                    "suffix": " Sekunden"
                },
                {
                    "name": "EnableDashboard",
                    "type": "CheckBox",
                    "caption": "Dashboard aktivieren"
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Variablen anlegen",
            "onClick": "BHP_SetupVariables($id);"
        },
        {
            "type": "Button",
            "caption": "Daten abrufen",
            "onClick": "BHP_RequestUpdate($id);"
        }
    ]
}
